# ---------------------------------------------------------------------------
# DeepFocus environment variables
# Copy to `.env` (root, for CLI) and `web/.env.local` (frontend) as noted below.
# ---------------------------------------------------------------------------

# --- CLI curator tooling (existing, unchanged) -----------------------------
ANTHROPIC_API_KEY=            # Claude Haiku for the add-video / add-external / gists CLI

# --- Server / Vercel function (api/ingest) ---------------------------------
# Set these in Vercel (Project → Settings → Environment Variables) AND in a
# root `.env` for local `npm run dev:api`.
SUPABASE_URL=                 # https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=            # Project API → anon/public key

# Which engine generates the analysis JSON: gemini (default) | claude | anakin
INGEST_PROVIDER=gemini
GEMINI_API_KEY=              # Google AI Studio key — used when INGEST_PROVIDER=gemini
# ANTHROPIC_API_KEY is reused from the CLI section above when INGEST_PROVIDER=claude

# URL scraping engine: anakin (default) | cheerio
# 'anakin' uses the anakin.io Scraping API (clean markdown) with ANAKIN_API_KEY
# ONLY — no appId, no Pro plan. Falls back to cheerio if slow/unavailable.
SCRAPE_PROVIDER=anakin
ANAKIN_API_KEY=               # anakin.io → Dashboard → API key (also used for scraping)
# ANAKIN_SCRAPE_URL=          # override; default https://api.anakin.io/v1/url-scraper

# Only needed when INGEST_PROVIDER=anakin (the AI-app platform; requires Anakin Pro):
ANAKIN_GIST_APP_ID=           # appId from your Quick App URL: app.anakin.ai/apps/<ID>

# --- Frontend (Vite) -> put these in web/.env.local ------------------------
# Vite only exposes vars prefixed with VITE_ to the browser. These are safe to
# expose (anon key is public); NEVER put ANAKIN_API_KEY here.
VITE_SUPABASE_URL=            # same as SUPABASE_URL
VITE_SUPABASE_ANON_KEY=       # same as SUPABASE_ANON_KEY
