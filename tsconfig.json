{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "dist-cli",
    "rootDir": "."
  },
  "include": ["scripts/**/*", "cli/**/*", "api/**/*"],
  "exclude": ["web", "node_modules"]
}
